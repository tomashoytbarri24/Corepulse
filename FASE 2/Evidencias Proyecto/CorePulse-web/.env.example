# Copia este archivo como .env.local (nunca lo subas a GitHub).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave «publishable» (sb_publishable_...) o la antigua «anon». Es pública: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección pública de la web (en local: http://localhost:3000; en Cloudflare: https://corepulse.cl o https://corepulse-web.<tu-cuenta>.workers.dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# SOLO en tu equipo, para `npm run subir-capturas`. NUNCA en Cloudflare ni en el navegador.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) o la antigua «service_role».
SUPABASE_SECRET_KEY=
