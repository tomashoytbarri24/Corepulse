# CorePulse · Variables de entorno para docker-compose.
# Copiar este archivo como .env y ajustar si hace falta. Nunca subir el .env con claves secretas.

# ---------- Base de datos local (PostgreSQL en Docker) ----------
POSTGRES_USER=corepulse
POSTGRES_PASSWORD=corepulse_local
POSTGRES_DB=corepulse
POSTGRES_PUERTO=5432

# ---------- Sitio web ----------
# Proyecto de Supabase que usa el sitio (cuentas, inicio de sesión y contenido).
# Estos valores son PÚBLICOS: son los mismos que recibe el navegador en corepulse.cl,
# y la seguridad de los datos la dan las políticas RLS de la base de datos.
# Para usar un proyecto propio: crear un proyecto en Supabase, ejecutar las migraciones
# de "Base de datos/supabase/migraciones" y poner aquí su URL y su clave publishable.
NEXT_PUBLIC_SUPABASE_URL=https://xxbcdxxiphcsuxewmqhf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__ndtI6Ho-L1AAdA36SsSxQ_x5prkWGT
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PUERTO=3000
