# Copiar a .env SOLO EN EL SERVIDOR y proteger permisos (chmod 600 .env).
# Reemplaza el ejemplo con un dominio real. No es una URL que exista actualmente.
COREPULSE_CLOUD_DOMAIN=ai.tu-dominio.example
# Ejemplo configurable; NO es nuestro modelo definitivo.
COREPULSE_MODEL_NAME=Qwen/Qwen3-8B
# Genera una clave distinta y larga: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
COREPULSE_MODEL_API_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO
COREPULSE_VLLM_IMAGE=vllm/vllm-openai:latest
HF_TOKEN=
COREPULSE_AI_DAILY_LIMIT=200
COREPULSE_AI_DEDUP_SECONDS=8
COREPULSE_MODEL_TIMEOUT=90
COREPULSE_MODEL_STATUS_TIMEOUT=3
COREPULSE_MODEL_TEMPERATURE=0.2
COREPULSE_MODEL_MAX_TOKENS=900
COREPULSE_CHAT_HISTORY_MESSAGES=8
