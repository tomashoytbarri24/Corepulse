COREPULSE_AI_HOST=127.0.0.1
COREPULSE_AI_PORT=8765
COREPULSE_AI_DAILY_LIMIT=200
COREPULSE_AI_DEDUP_SECONDS=8
# Los códigos de emparejamiento se emiten mediante: python -m app.admin issue

# Host generativo privado; en V460 la GPU y los modelos viven en el servidor, NO en Windows.
COREPULSE_MODEL_BASE_URL=
COREPULSE_MODEL_NAME=
COREPULSE_MODEL_API_KEY=
COREPULSE_MODEL_TIMEOUT=90
COREPULSE_MODEL_STATUS_TIMEOUT=3
COREPULSE_MODEL_TEMPERATURE=0.2
COREPULSE_MODEL_MAX_TOKENS=900
COREPULSE_CHAT_HISTORY_MESSAGES=8

# V463: SOLO si el backend usa el proveedor Groq. No poner claves en este archivo.
# COREPULSE_MODEL_PROVIDER=groq
# GROQ_API_KEY=   (mejor: Windows Credential Manager o secretos del host)

# V472: alternativa de API OpenAI-compatible. El asistente de Windows guarda
# endpoint/modelo en %LOCALAPPDATA% y la clave en Credential Manager.
# En despliegues Linux, configura los secretos a través del gestor del host.
# COREPULSE_MODEL_PROVIDER=openai_compatible
# COREPULSE_MODEL_BASE_URL=https://tu-inferencia-remota.example/v1
# COREPULSE_MODEL_NAME=modelo/remoto
# COREPULSE_MODEL_API_KEY=   (no distribuir secretos con el ZIP)
# No habilitar HTTP público para un proveedor alternativo.
